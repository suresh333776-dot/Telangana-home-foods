  <div class="cart-bottom-bar">
    <div class="cart-info">
      కార్ట్: <span id="cartCount">0</span> వస్తువులు | బిల్లు: ₹<span id="cartTotal">0</span>
    </div>
    <button class="checkout-btn" onclick="openCheckout()">పేమెంట్ & ఆర్డర్</button>
  </div>

  <div class="modal" id="checkoutModal">
    <div class="modal-content">
      <h3>చెల్లింపు & ఆర్డర్ వివరాలు</h3>
      <div class="upi-box">
        <p style="font-size: 0.85rem; font-weight: bold;">మొత్తం చెల్లించాల్సింది: ₹<span id="modalTotal">0</span></p>
        <p style="font-size: 0.75rem; color: #666; margin: 4px 0;">కింది UPI యాప్స్ ద్వారా పే చేయండి:</p>
        <div class="upi-apps">
          <a id="phonepeBtn" href="#" class="upi-btn" target="_blank">PhonePe</a>
          <a id="gpayBtn" href="#" class="upi-btn" target="_blank">GPay</a>
          <a id="paytmBtn" href="#" class="upi-btn" target="_blank">Paytm</a>
        </div>
        <p style="font-size: 0.75rem; color: #777; margin-top: 6px;">UPI ID: <strong>7095101860@ybl</strong></p>
      </div>

      <input type="text" id="custName" placeholder="మీ పూర్తి పేరు (Name)*" required>
      <input type="tel" id="custPhone" placeholder="మొబైల్ నంబర్ (Phone Number)*" required>
      <textarea id="custAddr" rows="2" placeholder="పూర్తి అడ్రస్ (Address)*" required></textarea>
      <input type="text" id="custUtr" placeholder="UPI UTR / Trans ID (12 అంకెలు)*" required>
      
      <div class="btn-group">
        <button class="cancel-btn" onclick="closeCheckout()">రద్దు</button>
        <button class="checkout-btn" onclick="submitToWhatsApp()">WhatsApp లో కన్ఫర్మ్ చేయి</button>
      </div>
    </div>
  </div>

  <script>
    const ownerNumber = "917095101860";
    const ownerUpi = "7095101860@ybl";
    let cart = [];

    function addToCart(name, price) {
      cart.push({ name, price });
      updateCartBar();
      alert(name + " కార్ట్‌కి జోడించబడింది!");
    }

    function updateCartBar() {
      document.getElementById('cartCount').innerText = cart.length;
      const total = cart.reduce((sum, item) => sum + item.price, 0);
      document.getElementById('cartTotal').innerText = total;
    }

    function filterItems(cat) {
      const tabs = document.querySelectorAll('.tab-btn');
      tabs.forEach(t => t.classList.remove('active'));
      event.target.classList.add('active');

      const blocks = document.querySelectorAll('.category-block');
      blocks.forEach(b => {
        b.style.display = (cat === 'all' || b.getAttribute('data-cat') === cat) ? 'block' : 'none';
      });
    }

    function openCheckout() {
      if (cart.length === 0) {
        alert("దయచేసి ముందుగా ఏదైనా వస్తువును కార్ట్‌లోకి ఎంచుకోండి!");
        return;
      }
      const total = cart.reduce((sum, item) => sum + item.price, 0);
      document.getElementById('modalTotal').innerText = total;

      const upiLink = `upi://pay?pa=${ownerUpi}&pn=TelanganaHomeFoods&am=${total}&cu=INR`;
      document.getElementById('phonepeBtn').href = upiLink;
      document.getElementById('gpayBtn').href = upiLink;
      document.getElementById('paytmBtn').href = upiLink;

      document.getElementById('checkoutModal').style.display = 'flex';
    }

    function closeCheckout() {
      document.getElementById('checkoutModal').style.display = 'none';
    }

    function submitToWhatsApp() {
      const name = document.getElementById('custName').value.trim();
      const phone = document.getElementById('custPhone').value.trim();
      const addr = document.getElementById('custAddr').value.trim();
      const utr = document.getElementById('custUtr').value.trim();

      if (!name || !phone || !addr) {
        alert("దయచేసి పేరు, ఫోన్ నంబర్ మరియు అడ్రస్ పూర్తిగా నమోదు చేయండి.");
        return;
      }
      if (utr.length < 6) {
        alert("దయచేసి పేమెంట్ చేసిన Transaction ID (UTR Number) నమోదు చేయండి.");
        return;
      }

      const total = cart.reduce((sum, item) => sum + item.price, 0);
      let itemsList = "";
      cart.forEach((item, i) => {
        itemsList += `${i + 1}. ${item.name} ${item.price > 0 ? '- ₹' + item.price : '(ఫ్రెష్ ఆర్డర్)'}\n`;
      });

      let msg = `✅ *కొత్త ఆర్డర్ (పేమెంట్ పూర్తయింది)*\n\n` +
                `👤 *కస్టమర్ పేరు:* ${name}\n` +
                `📞 *ఫోన్ నంబర్:* ${phone}\n` +
                `🏠 *అడ్రస్:* ${addr}\n` +
                `💳 *UPI UTR / Trans ID:* ${utr}\n` +
                `💰 *మొత్తం బిల్లు:* ₹${total}\n\n` +
                `📦 *ఆర్డర్ చేసిన వస్తువులు:*\n${itemsList}\n` +
                `దయచేసి పేమెంట్ చెక్ చేసి ఆర్డర్ పంపగలరు.`;

      window.open(`https://wa.me/${ownerNumber}?text=${encodeURIComponent(msg)}`, '_blank');

      cart = [];
      updateCartBar();
      closeCheckout();
    }
  </script>
</body>
</html>
